@startuml RefrigeratorCoolingSystem
!theme blueprint
' STYLE START
hide empty members
skinparam shadowing false
' STYLE END
set namespaceSeparator none
package "RefrigeratorCoolingSystem" {
    class "Resistance" as Resistance << (C, DarkSeaGreen) >> 
    class "Compressor" as Compressor << (C, DarkSeaGreen) >> 
    class "Fan" as Fan << (C, DarkSeaGreen) >> 
    class "Temperature" as Temperature << (C, DarkSeaGreen) >> 
    class "Regulador" as Regulador << (C, DarkSeaGreen) >> 
}
@enduml
